# Copy to server/.env (ignored), then use: node --env-file=server/.env server/index.mjs
PUBLIC_ORIGIN=http://127.0.0.1:5173
PORT=8787
HOST=127.0.0.1
# Comma-separated wallet addresses. Required when NODE_ENV=production.
BETA_ALLOWLIST=
BASE_RPC_URL=https://base-rpc.publicnode.com
# Local development keeps the existing SQLite save by default.
# Production low-cost option: ADC service identity, no downloaded private key.
# STORE_BACKEND=firestore
# FIRESTORE_PROJECT_ID=your-project-id
# FIRESTORE_NAMESPACE=beta
# FIRESTORE_DATABASE_ID=(default)
# Existing PostgreSQL remains supported; use TLS certificate verification and
# a restricted user. Switching backends does NOT copy saves automatically.
# STORE_BACKEND=postgres
# DATABASE_URL=postgresql://...
