{
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".jpg": "image/jpeg"
  },
  "routes": [
    {"route":"/pilot-v2","rewrite":"/pilot-v2/index.html","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/pilot-v2/*","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/soul","rewrite":"/soul/index.html","headers":{"Cache-Control":"no-cache"}},
    {"route":"/soul/*","headers":{"Cache-Control":"no-cache"}},
    {"route":"/pilot","rewrite":"/pilot/index.html","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/pilot/*","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/buy","rewrite":"/buy/index.html","headers":{"Cache-Control":"no-cache"}},
    {"route":"/buy/*","headers":{"Cache-Control":"no-cache"}},
    {"route":"/manage","rewrite":"/manage/index.html","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/manage/*","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/whitepaper","rewrite":"/whitepaper/index.html","headers":{"Cache-Control":"no-cache"}},
    {"route":"/whitepaper/*","headers":{"Cache-Control":"no-cache"}},
    {"route":"/testnet","rewrite":"/testnet/index.html","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/testnet/*","headers":{"Cache-Control":"no-store","X-Robots-Tag":"noindex, nofollow"}},
    {"route":"/assets/*","headers":{"Cache-Control":"public, max-age=31536000, immutable"}},
    {"route":"/media/souli-moments/v1/*","headers":{"Cache-Control":"public, max-age=31536000, immutable"}},
    {"route":"/*.html","headers":{"Cache-Control":"no-cache"}},
    {"route":"/","headers":{"Cache-Control":"no-cache"}}
  ],
  "globalHeaders": {
    "Content-Security-Policy":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.souli.net https://mainnet.base.org https://base-rpc.publicnode.com https://sepolia.base.org wss://mm-sdk-relay.api.cx.metamask.io; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
    "Strict-Transport-Security":"max-age=31536000",
    "X-Content-Type-Options":"nosniff",
    "X-Frame-Options":"DENY",
    "Referrer-Policy":"same-origin",
    "Permissions-Policy":"camera=(), microphone=(), geolocation=()"
  }
}
